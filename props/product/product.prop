# Variant specific props
import /product/etc/product.${ro.boot.hwname}.prop

# Boot animation theming
ro.boot.theme=1

# Device mask
ro.build.fingerprint=google/barbet/barbet:14/AP1A.240405.002/11480754:user/release-keys
ro.product.brand=google
ro.product.device=barbet
ro.product.manufacturer=Google
ro.product.model=Pixel 5a
ro.product.name=barbet

# Enable one-handed mode
ro.support_one_handed_mode=true

# RKPD
remote_provisioning.enable_rkpd=true
remote_provisioning.hostname=remoteprovisioning.googleapis.com
